# Example Pulumi stack configuration file
# Copy this to Pulumi.dev.yaml (or your stack name) and fill in your values
# DO NOT commit the actual Pulumi.*.yaml files - they contain secrets!

config:
  # Required: Your Scaleway project ID
  new-platform-spawner:project_id: "12345678-1234-5678-1234-567812345678"
  
  # Required: Topology to deploy
  # Options: "single-node", "3-nodes", "6-nodes"
  new-platform-spawner:topology: "single-node"
  
  # Optional: Cloud provider (default: scaleway)
  # Options: "scaleway", "aws" (future), "ovh" (future)
  new-platform-spawner:provider: "scaleway"
  
  # Optional: Scaleway region (default: fr-par)
  # Options: "fr-par" (Paris), "nl-ams" (Amsterdam), "pl-waw" (Warsaw)
  new-platform-spawner:region: "fr-par"
  
  # Optional: Scaleway zone (default: fr-par-1)
  # Options: "fr-par-1", "fr-par-2", "fr-par-3", "nl-ams-1", "nl-ams-2", "pl-waw-1", "pl-waw-2"
  new-platform-spawner:zone: "fr-par-1"
  
  # Optional: Operating system for BASTION node (default: rockylinux)
  # Bastion always uses marketplace image (latest patched version)
  # Options: "rockylinux", "ubuntu", "debian"
  new-platform-spawner:bastion_os_name: "rockylinux"
  
  # Optional: OS version for BASTION node (default: 9)
  new-platform-spawner:bastion_os_version: "9"
  
  # Optional: Snapshot/image ID for WORKER NODES
  # If set, worker nodes use this custom snapshot (e.g., pre-configured Artesca OS)
  # If not set, worker nodes use the same OS as bastion (marketplace image)
  # Get snapshot ID from: https://console.scaleway.com/instance/images
  # new-platform-spawner:worker_snapshot_id: "11111111-2222-3333-4444-555555555555"
  
  # Optional: Instance type for WORKER NODES (default: PRO2-S)
  # Note: Bastion always uses PLAY2-NANO (small machine for SSH only)
  # Dev worker nodes: PLAY2-MICRO
  # Prod worker nodes: PRO2-S (default), PRO2-M, PRO2-L
  new-platform-spawner:instance_type: "PRO2-S"
  
  # Optional: Additional volumes for WORKER NODES (bastion does not get these)
  # Format: JSON array with objects containing "suffix", "size", and optional "count"
  # Each volume configuration creates 'count' volumes (default: 1) of 'size' GB
  # Example: 1 service volume (120GB) + 12 data volumes (10GB each)
  # new-platform-spawner:additional_volumes: '[{"suffix": "service", "size": 120}, {"suffix": "data", "size": 10, "count": 12}]'
  
  # Required: Scaleway API credentials (stored encrypted by Pulumi)
  # Get these from: https://console.scaleway.com/iam/api-keys
  # Set with: pulumi config set --secret scaleway:access_key YOUR_KEY
  scaleway:access_key:
    secure: "YOUR_ENCRYPTED_ACCESS_KEY_HERE"
  scaleway:secret_key:
    secure: "YOUR_ENCRYPTED_SECRET_KEY_HERE"

# Example configurations for different scenarios:

# Development - Single Node:
# topology: "single-node"
# instance_type: "PLAY2-MICRO"  # For worker node (bastion always PLAY2-NANO)

# Staging - 3 Nodes:
# topology: "3-nodes"
# instance_type: "PLAY2-MICRO"  # For 3 worker nodes (bastion always PLAY2-NANO)

# Production - 6 Nodes:
# topology: "6-nodes"
# instance_type: "PRO2-S"  # For 6 worker nodes (bastion always PLAY2-NANO)
# region: "fr-par"
# zone: "fr-par-1"

